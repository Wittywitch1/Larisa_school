@page
@model Androne_Larisa_lab2.Pages.BooksPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Books</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Books.ID" />
            <div class="form-group">
                <label asp-for="Books.Title" class="control-label"></label>
                <input asp-for="Books.Title" class="form-control" />
                <span asp-validation-for="Books.Title" class="text-danger"></span>
            </div>
       
            <div class="form-group">
                <label asp-for="Books.Price" class="control-label"></label>
                <input asp-for="Books.Price" class="form-control" />
                <span asp-validation-for="Books.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Books.PublishingDate" class="control-label"></label>
                <input asp-for="Books.PublishingDate" class="form-control" type="date" />
                <span asp-validation-for="Books.PublishingDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Books.PublisherID" class="control-label">Publisher Name</label>
                <select asp-for="Books.PublisherID" class="form-control" asp-items="ViewBag.PublisherID">
                </select>
                <span asp-validation-for="Books.PublisherID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Books.AuthorID" class="control-label">
                    Author Name
                </label>

                <select asp-for="Books.AuthorID"
                        class="form-control"
                        asp-items="ViewBag.AuthorID">
                    <option value="">-- Select Author --</option>
                </select>

                <span asp-validation-for="Books.AuthorID"
                      class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
